{
  "name": "pdf-tools-pro",
  "productName": "全民好用PDF桌面版",
  "description": "全民好用PDF桌面版 - 本地化PDF全能工具箱",
  "author": "朱澄亮",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win --x64 --arm64",
    "build:linux": "vite build && electron-builder --linux AppImage deb --x64 --arm64",
    "build:linux:dir": "vite build && electron-builder --linux dir --x64 --arm64",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.pdf-tools-pro.app",
    "compression": "maximum",
    "afterPack": "scripts/afterPack.cjs",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png",
      "category": "Office",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "directories": {
      "output": "dist-electron"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Editor",
        "icon": "public/logo.png"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "dist/**/*",
      "!dist/*.zip",
      "!dist-electron{,/**}",
      "electron/**/*",
      "!node_modules/@napi-rs{,/**}",
      "!node_modules/**/{test,tests,__tests__,example,examples,docs,doc,CHANGELOG,changelog,README,readme}.{md,txt,js,ts}",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.flow",
      "!node_modules/**/.github",
      "!node_modules/**/.eslintrc*",
      "!node_modules/**/.prettierrc*",
      "!node_modules/**/tsconfig*",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.tsx"
    ],
    "extraResources": [
      {
        "from": "python_engine",
        "to": "python_engine",
        "filter": [
          "converter.py",
          "requirements.txt"
        ]
      }
    ]
  },
  "dependencies": {
    "lucide-react": "^1.11.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10"
  }
}
